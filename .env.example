# AI Chat Server Configuration (Server-side only)
# Never expose these keys to the client or frontend Vite variables.

# Port for the Express server
PORT=3001

# OpenAI-compatible API configuration
# Example providers: OpenAI, Groq, OpenRouter, Together AI, Ollama
AI_API_BASE_URL=https://api.openai.com/v1
AI_API_KEY=your_openai_or_compatible_api_key_here
AI_MODEL=gpt-4o-mini

# Optional system fallback timeout in milliseconds (default: 8000)
AI_TIMEOUT_MS=8000
